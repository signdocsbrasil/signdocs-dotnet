<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>SignDocsBrasil.Api</PackageId>
    <Version>2.0.1</Version>
    <Authors>SignDocsBrasil</Authors>
    <Description>SDK oficial em .NET para a API SignDocs Brasil: assinatura eletrônica e digital com ICP-Brasil, biometria, OTP e trilha de evidências (Brazilian e-signature API SDK)</Description>
    <PackageTags>signdocs;signdocs-brasil;assinatura;assinatura-digital;assinatura-eletronica;assinatura-de-documentos;assinador;certificado-digital;icp-brasil;biometria;digital-signature;electronic-signature;e-signature;esignature;document-signing;brasil;brazil;api;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/signdocsbrasil/signdocs-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://docs.signdocs.com.br</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591;CS1574</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
